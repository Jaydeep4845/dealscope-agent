# LLM: any one of these (all have free tiers or run locally)
GEMINI_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# SEC EDGAR requires a descriptive User-Agent with a contact email
SEC_USER_AGENT="dealscope-agent your-email@example.com"

# Langfuse (self-hosted via docker or free cloud tier)
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Hugging Face (write token from huggingface.co/settings/tokens)
HF_TOKEN=
HF_DATASET_REPO=jc4845/sec-10k-retrieval-qa
HF_MODEL_REPO=jc4845/bge-small-sec-filings
